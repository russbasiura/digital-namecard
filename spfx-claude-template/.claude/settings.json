{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(nvm:*)",
      "Bash(yo:*)",
      "Bash(m365:*)",
      "Bash(git:*)",
      "Bash(python3:*)",
      "Bash(bash scripts/*)",
      "Bash(./scripts/*)",
      "Bash(scripts/*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:pnp.github.io)",
      "WebFetch(domain:www.npmjs.com)"
    ],
    "deny": [
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(m365 spo app remove:*)",
      "Bash(m365 spo app retract:*)",
      "Bash(m365 spo list remove:*)",
      "Bash(m365 spo field remove:*)",
      "Bash(m365 spo site remove:*)",
      "Bash(m365 spo tenant settings set:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\""
          }
        ]
      }
    ]
  }
}
